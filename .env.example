# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional persistent Cloud Run storage. Keep DATABASE_PASSWORD in Secret
# Manager in deployed environments; never commit its value.
# CLOUD_SQL_CONNECTION_NAME=project:us-east1:coscientist-db
# DATABASE_NAME=coscientist
# SESSION_DATABASE_NAME=coscientist_adk
# DATABASE_USER=coscientist_app
# DATABASE_PASSWORD=replace-with-a-secret
# LOGS_BUCKET_NAME=project-coscientist-artifacts

# Iterative evidence pipeline (new sessions only)
EVIDENCE_PIPELINE_VERSION=2
EVIDENCE_REPEAT_PASSES=false
EVIDENCE_ENABLE_PASS_3=false
# Gemini Developer API key used only by the stored Interactions Deep Research API.
# In Cloud Run, inject this value from Secret Manager; never commit the value.
GEMINI_API_KEY=replace-with-a-secret
EVIDENCE_BUCKET_NAME=
EVIDENCE_WORKER_URL=
EVIDENCE_CLOUD_TASKS_QUEUE=coscientist-evidence
EVIDENCE_COST_WARNING_USD=6
EVIDENCE_COST_LIMIT_USD=10
# Optional verified-only Vertex AI Search data store. Never ingest session content.
AGENT_SEARCH_DATA_STORE=
